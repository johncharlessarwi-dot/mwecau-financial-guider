# Local Vite development only.
VITE_API_URL=http://localhost:8000

# For Cloudflare Workers production builds, set this variable in the
# frontend BUILD environment (not only Worker runtime variables), using
# the HTTPS origin of a deployed Laravel API. Trigger a new deployment.
# Example: VITE_API_URL=https://YOUR_ACTUAL_LARAVEL_API_HOST
# Do not put credentials, tokens or server secrets into any VITE_ variable.
# Without a valid production HTTPS API, login and registration are disabled.

{
  "name": "mwecau/guider-api",
  "type": "project",
  "description": "MWECau GUIDER personal finance API",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^13.39",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": {
    "test": "php artisan test",
    "format": "vendor/bin/pint"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": { "php-http/discovery": true }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}